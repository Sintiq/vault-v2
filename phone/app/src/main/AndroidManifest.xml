<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The agent door. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- So the phone can ask the owner before anything in the owner-only tier. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android requires this even to read the name of the connected wifi;
         a location fix itself is never taken without a tap on the phone. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- So a door the owner left open comes back after the phone restarts. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- The phone's own step counter, for the Watch tab until there is a watch. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- What the watch writes into Health Connect: read only, never write.
         Android asks the owner for each one; none is granted by installing. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_OXYGEN_SATURATION" />
    <!-- Lets the door open an app outright instead of leaving a notification:
         Android exempts apps the owner has allowed to display over others from
         its background-launch restriction. Granted by the owner in Settings. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- One frame of the screen, and only after the owner allows it here and
         again in Android's own dialog. Declared for API 34; harmless on 33. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!--
      Since Android 11 an app cannot see other apps unless it says which ones
      it needs. "Ask to open an app" needs exactly one thing: the launcher
      entry, the same icon the owner would tap himself. Without this, the door
      answered "no such app" for everything but a few system apps.

      Deliberately not QUERY_ALL_PACKAGES: the installed-app list says a lot
      about a person, and nothing here needs it.
    -->
    <queries>
        <!-- Health Connect is a separate app on Android 13. -->
        <package android:name="com.google.android.apps.healthdata" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- An update is installed only when the owner confirms it in Android's own dialog. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Vault">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Vault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The pairing QR from the PC: a one-time ticket, never a key. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="vault-pair" android:host="pair" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.export"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/export_paths" />
        </provider>

        <receiver android:name=".ChooserReceiver" android:exported="false" />
        <receiver android:name=".InstallReceiver" android:exported="false" />

        <!-- Health Connect shows this page when the owner asks why Vault wants
             his health data; without it, Android 13 will not show the prompt. -->
        <activity
            android:name=".HealthRationaleActivity"
            android:exported="true"
            android:theme="@style/Theme.Vault">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <activity
            android:name=".door.ScreenshotActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".door.ScreenshotService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- A finger, and nothing more: see res/xml/input_service.xml, which
             asks Android for no screen contents at all. -->
        <service
            android:name=".door.InputService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/input_service" />
        </service>

        <receiver
            android:name=".door.BootReceiver"
            android:exported="true"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".door.DoorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Holds a socket on the owner's private Tailscale network so the
                    owner's own agent can ask this phone for battery, wifi and location, each
                    call logged on the device and the owner asked before anything personal." />
        </service>
    </application>
</manifest>
